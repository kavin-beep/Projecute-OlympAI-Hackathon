# Copy to .env and fill in. .env is git-ignored and never printed or logged.
# Without a key the prototype runs in labelled demo mode and the whole demo still works.
# Your Groq API key (free at https://console.groq.com/keys), and the main OpenAI model.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Backup OpenAI model used automatically when the main one hits a rate limit.
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Optional. Not set in this build, so images and audio use the labelled mock path.
IMAGE_API_KEY=
AUDIO_API_KEY=
