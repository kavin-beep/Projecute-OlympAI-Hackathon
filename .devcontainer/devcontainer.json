// GitHub Codespaces setup: open the repo in a browser and Projecute starts by itself.
// Judges can paste their own free Groq key as GROQ_API_KEY when creating the codespace;
// without it the app runs in labelled demo mode.
{
  "name": "Projecute",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "hostRequirements": { "cpus": 2, "memory": "4gb" },

  // CPU-only PyTorch avoids a 2 GB GPU download; then the project's dependencies.
  "postCreateCommand": "pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir -r requirements.txt",

  // Start the app every time the codespace opens.
  "postAttachCommand": "python main.py",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Projecute", "onAutoForward": "openBrowser" }
  },

  "secrets": {
    "GROQ_API_KEY": {
      "description": "Optional. A free Groq API key turns on live AI; leave empty for demo mode.",
      "documentationUrl": "https://console.groq.com/keys"
    }
  },

  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
